{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Sid": "ChatHistoryReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME/chat-history/*"
    },
    {
      "Sid": "DocsReadOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET_NAME/docs/*"
    },
    {
      "Sid": "S3VectorsQueryAndIndexing",
      "Effect": "Allow",
      "Action": [
        "s3vectors:GetVectorBucket",
        "s3vectors:CreateVectorBucket",
        "s3vectors:GetIndex",
        "s3vectors:CreateIndex",
        "s3vectors:DeleteIndex",
        "s3vectors:QueryVectors",
        "s3vectors:GetVectors",
        "s3vectors:PutVectors",
        "s3vectors:ListVectors",
        "s3vectors:DeleteVectors"
      ],
      "Resource": [
        "arn:aws:s3vectors:REGION:ACCOUNT_ID:bucket/VECTOR_BUCKET",
        "arn:aws:s3vectors:REGION:ACCOUNT_ID:bucket/VECTOR_BUCKET/index/*"
      ]
    }
  ]
}